# NVIDIA AI Endpoints Configuration
# Set your NVIDIA API key here (get it from https://build.nvidia.com/)
NVIDIA_API_KEY=your-nvidia-api-key-here

# Optional: Custom base URL (default: https://integrate.api.nvidia.com/v1)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Default model (default: nvidia/nemotron-3-ultra-550b-a55b)
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b